generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique @db.VarChar(100)
  email     String   @unique @db.VarChar(150)
  password  String   @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model CompanySettings {
  id            Int      @id @default(autoincrement())
  companyName   String   @db.VarChar(200)
  gstin         String   @db.VarChar(20)
  dlNumber      String   @db.VarChar(100)
  address       String   @db.Text
  mobile        String   @db.VarChar(20)
  email         String?  @db.VarChar(150)
  fssaiNumber   String?  @db.VarChar(50)
  bankName      String?  @db.VarChar(100)
  accountNumber String?  @db.VarChar(30)
  ifscCode      String?  @db.VarChar(20)
  upiId         String?  @db.VarChar(50)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

model Product {
  id           Int          @id @default(autoincrement())
  name         String       @db.VarChar(200)
  companyName  String       @db.VarChar(200)
  hsnCode      String       @db.VarChar(20)
  pack         String?      @db.VarChar(50)
  manufacturer String?      @db.VarChar(200)
  gstPercent   Decimal      @db.Decimal(5, 2)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt
  batches      BatchStock[]
  purchaseItems PurchaseItem[]
  invoiceItems InvoiceItem[]
}

model BatchStock {
  id            Int           @id @default(autoincrement())
  productId     Int
  product       Product       @relation(fields: [productId], references: [id])
  batchNumber   String        @db.VarChar(50)
  expiryDate    DateTime
  mrp           Decimal       @db.Decimal(10, 2)
  purchaseRate  Decimal       @db.Decimal(10, 2)
  sellingRate   Decimal       @db.Decimal(10, 2)
  availableQty  Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
  purchaseItems PurchaseItem[]
  invoiceItems  InvoiceItem[]

  @@unique([productId, batchNumber])
}

model Customer {
  id            Int       @id @default(autoincrement())
  storeName     String    @db.VarChar(200)
  gstNumber     String?   @db.VarChar(20)
  dlNumber      String?   @db.VarChar(100)
  mobile        String    @db.VarChar(15)
  address       String    @db.Text
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  invoices      Invoice[]
}

model Supplier {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(200)
  gstNumber String?    @db.VarChar(20)
  mobile    String     @db.VarChar(15)
  address   String     @db.Text
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  purchases Purchase[]
}

model Purchase {
  id             Int            @id @default(autoincrement())
  purchaseNumber String         @unique @db.VarChar(30)
  supplierId     Int
  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  invoiceNumber  String?        @db.VarChar(50)
  invoiceDate    DateTime
  totalAmount    Decimal        @db.Decimal(12, 2)
  totalTax       Decimal        @db.Decimal(12, 2)
  grandTotal     Decimal        @db.Decimal(12, 2)
  notes          String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt
  items          PurchaseItem[]
}

model PurchaseItem {
  id           Int        @id @default(autoincrement())
  purchaseId   Int
  purchase     Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId    Int
  product      Product    @relation(fields: [productId], references: [id])
  batchStockId Int
  batchStock   BatchStock @relation(fields: [batchStockId], references: [id])
  batchNumber  String     @db.VarChar(50)
  expiryDate   DateTime
  qty          Int
  freeQty      Int        @default(0)
  purchaseRate Decimal    @db.Decimal(10, 2)
  sellingRate  Decimal    @db.Decimal(10, 2)
  mrp          Decimal    @db.Decimal(10, 2)
  gstPercent   Decimal    @db.Decimal(5, 2)
  taxableAmt   Decimal    @db.Decimal(12, 2)
  cgst         Decimal    @db.Decimal(10, 2)
  sgst         Decimal    @db.Decimal(10, 2)
  totalAmt     Decimal    @db.Decimal(12, 2)
  createdAt    DateTime   @default(now())
}

model Invoice {
  id            Int           @id @default(autoincrement())
  invoiceNumber String        @unique @db.VarChar(30)
  customerId    Int
  customer      Customer      @relation(fields: [customerId], references: [id])
  invoiceDate   DateTime      @default(now())
  subTotal      Decimal       @db.Decimal(12, 2)
  totalDiscount Decimal       @db.Decimal(10, 2) @default(0)
  taxableAmt    Decimal       @db.Decimal(12, 2)
  totalCgst     Decimal       @db.Decimal(10, 2)
  totalSgst     Decimal       @db.Decimal(10, 2)
  roundOff      Decimal       @db.Decimal(5, 2)  @default(0)
  grandTotal    Decimal       @db.Decimal(12, 2)
  paidAmount    Decimal       @db.Decimal(12, 2) @default(0)
  dueAmount     Decimal       @db.Decimal(12, 2) @default(0)
  paymentStatus String        @default("Unpaid") @db.VarChar(20)
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
  items         InvoiceItem[]
  paymentHistory PaymentHistory[]
}

model InvoiceItem {
  id           Int        @id @default(autoincrement())
  invoiceId    Int
  invoice      Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId    Int
  product      Product    @relation(fields: [productId], references: [id])
  batchStockId Int
  batchStock   BatchStock @relation(fields: [batchStockId], references: [id])
  batchNumber  String     @db.VarChar(50)
  expiryDate   DateTime
  mrp          Decimal    @db.Decimal(10, 2)
  qty          Int
  freeQty      Int        @default(0)
  rate         Decimal    @db.Decimal(10, 2)
  discount     Decimal    @db.Decimal(5, 2)  @default(0)
  gstPercent   Decimal    @db.Decimal(5, 2)
  taxableAmt   Decimal    @db.Decimal(12, 2)
  cgst         Decimal    @db.Decimal(10, 2)
  sgst         Decimal    @db.Decimal(10, 2)
  amount       Decimal    @db.Decimal(12, 2)
  createdAt    DateTime   @default(now())
}

enum PaymentMethod {
  CASH
  UPI
}

model PaymentHistory {
  id            Int           @id @default(autoincrement())
  invoiceId     Int
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  note          String?       @db.Text
  paymentDate   DateTime      @default(now())
  createdAt     DateTime      @default(now())
}

